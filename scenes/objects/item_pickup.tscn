[sub_resource type="Shader" id="Shader_glow_cylinder"]
code = "shader_type spatial;
render_mode blend_add, depth_draw_never, cull_disabled, unshaded;

uniform vec4 glow_color : source_color = vec4(1.0, 0.84, 0.0, 1.0);
uniform float intensity : hint_range(0.0, 5.0) = 1.5;
uniform float pulse_speed : hint_range(0.0, 10.0) = 2.0;
uniform float pulse_amount : hint_range(0.0, 1.0) = 0.3;

void fragment() {
	// UV.y: 0 at top, 1 at bottom on cylinder
	// We want: full opacity at bottom (UV.y=1), transparent at top (UV.y=0)
	float height_fade = UV.y;  // 1 at bottom, 0 at top
	height_fade = pow(height_fade, 0.7); // Faster fade toward top
	
	// Edge fade - softer edges on sides
	float edge = abs(UV.x - 0.5) * 2.0;
	float edge_fade = 1.0 - pow(edge, 1.5);
	
	// Pulsing glow
	float pulse = 1.0 + sin(TIME * pulse_speed) * pulse_amount;
	
	// Combine all factors
	float alpha = height_fade * edge_fade * glow_color.a * pulse * 0.6;
	
	ALBEDO = glow_color.rgb * intensity * pulse;
	ALPHA = clamp(alpha, 0.0, 1.0);
}
"

